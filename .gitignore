# 잡 폴더 (실적 수치 포함, 절대 커밋하지 않는다)
jobs/

# Python
__pycache__/
*.py[cod]

# Node
node_modules/

# 산출물 (잡 폴더 밖으로 흘러나온 경우 대비)
*.pptx
*.xlsx

# 단, 스킬 원본의 기준본·템플릿은 커밋한다 (계획서 2.15).
# 스킬 파일이 구버전으로 되돌아가 규칙이 통째로 사라진 일이 반복해서 있었다.
# 그걸 막으려고 원본을 리포에 두기로 한 것이므로 assets도 같이 들어와야 한다.
!skill/**/*.pptx

# 맥이 폴더를 열 때 자동으로 만드는 보기 설정 파일. 프로젝트와 무관하다
.DS_Store

# 지시 전문. 리포에 커밋하지 않는다 (내용이 길고 커밋 메시지가 정본이다)
dispatch/
